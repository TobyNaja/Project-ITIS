# Copy to .env and fill in your local lab values.
# NEVER commit real credentials or environment-specific secrets.
#
# ค่าระบบ (window, min_events, duration, weights, paths) อยู่ใน config/config.yaml
# ไฟล์นี้เก็บเฉพาะค่าที่ผูกกับเครื่อง/สภาพแวดล้อม (NFR-07)

# required ตอนรันจริง — ไม่มี = ConfigError
ITIS_PFSENSE_HOST=

# optional — ถ้าตั้งไว้จะ override eve.path ใน config/config.yaml
ITIS_EVE_PATH=
